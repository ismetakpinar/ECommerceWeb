<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - ECommerce</title>

    @await Html.PartialAsync("Components/_Styles")
</head>

<body>

    @await Html.PartialAsync("Components/_TopBar")

    @await Html.PartialAsync("Components/_Header")

    @await Html.PartialAsync("Components/_Navbar")

    <main role="main">
        @if (TempData["Success"] is string successMessage)
        {
            <div class="container mt-3">
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @successMessage
                    <button type="button" class="close" data-dismiss="alert" aria-label="Kapat">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            </div>
        }

        @if (TempData["Error"] is string errorMessage)
        {
            <div class="container mt-3">
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @errorMessage
                    <button type="button" class="close" data-dismiss="alert" aria-label="Kapat">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            </div>
        }

        @RenderBody()
    </main>

    @await Html.PartialAsync("Components/_Footer")

    @await Html.PartialAsync("Components/_Scripts")

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>