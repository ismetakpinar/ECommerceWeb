@inject ECommerce.Web.Infrastructure.Authentication.ITokenService TokenService

<!-- Navbar Start -->
<div class="container-fluid bg-dark mb-30">
    <div class="row px-xl-5">
        <div class="col-lg-3 d-none d-lg-block">
            <a class="btn d-flex align-items-center justify-content-between bg-primary w-100"
               data-toggle="collapse"
               href="#navbar-vertical"
               style="height: 65px; padding: 0 30px;">
                <h6 class="text-dark m-0">
                    <i class="fa fa-bars mr-2"></i>Kategoriler
                </h6>
                <i class="fa fa-angle-down text-dark"></i>
            </a>

            <nav class="collapse position-absolute navbar navbar-vertical navbar-light align-items-start p-0 bg-light"
                 id="navbar-vertical"
                 style="width: calc(100% - 30px); z-index: 999;">

                <div class="navbar-nav w-100">

                    <div class="nav-item dropdown dropright">
                                <a asp-controller="Product"
                                    asp-action="Index"
                           class="nav-link dropdown-toggle"
                           data-toggle="dropdown">
                            Kategoriler
                            <i class="fa fa-angle-right float-right mt-1"></i>
                        </a>

                        <div class="dropdown-menu position-absolute rounded-0 border-0 m-0">
                            <a href="/#categories" class="dropdown-item">Kategoriler</a>
                            <a asp-controller="Product" asp-action="Index" class="dropdown-item">Tüm Ürünler</a>
                            <a asp-controller="Account" asp-action="Register" class="dropdown-item">Kayıt Ol</a>
                        </div>
                    </div>

                    <a href="/#categories" class="nav-item nav-link">Kategoriler</a>
                    <a asp-controller="Cart" asp-action="Index" class="nav-item nav-link">Sepetim</a>
                    <a asp-controller="Order" asp-action="Index" class="nav-item nav-link">Siparişlerim</a>

                </div>
            </nav>
        </div>

        <div class="col-lg-9">
            <nav class="navbar navbar-expand-lg bg-dark navbar-dark py-3 py-lg-0 px-0">

                <a href="/" class="text-decoration-none d-block d-lg-none">
                    <span class="h1 text-uppercase text-dark bg-light px-2">Multi</span>
                    <span class="h1 text-uppercase text-light bg-primary px-2 ml-n1">Shop</span>
                </a>

                <button type="button"
                        class="navbar-toggler"
                        data-toggle="collapse"
                        data-target="#navbarCollapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse justify-content-between"
                     id="navbarCollapse">

                    <div class="navbar-nav mr-auto py-0">
                        <a asp-controller="Home" asp-action="Index" class="nav-item nav-link active">Ana Sayfa</a>
                        <a asp-controller="Product" asp-action="Index" class="nav-item nav-link">Ürünler</a>

                        <div class="nav-item dropdown">
                            <a asp-controller="Cart" asp-action="Index"
                               class="nav-link dropdown-toggle"
                               data-toggle="dropdown">
                                Mağaza
                                <i class="fa fa-angle-down mt-1"></i>
                            </a>

                            <div class="dropdown-menu bg-primary rounded-0 border-0 m-0">
                                <a asp-controller="Cart" asp-action="Index" class="dropdown-item">Sepetim</a>
                                <a asp-controller="Checkout" asp-action="Index" class="dropdown-item">Ödeme</a>
                            </div>
                        </div>

                        @if (string.IsNullOrWhiteSpace(TokenService.GetAccessToken()))
                        {
                            <a asp-controller="Account" asp-action="Login" class="nav-item nav-link">Giriş Yap</a>
                            <a asp-controller="Account" asp-action="Register" class="nav-item nav-link">Kayıt Ol</a>
                        }
                        else
                        {
                            <a asp-controller="Order" asp-action="Index" class="nav-item nav-link">Siparişlerim</a>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="nav-item nav-link border-0 bg-transparent">Çıkış Yap</button>
                            </form>
                        }
                    </div>

                    <div class="navbar-nav ml-auto py-0 d-none d-lg-block">

                        <a asp-controller="Cart" asp-action="Index" class="btn px-0" title="Sepetim" aria-label="Sepetim">
                            <i class="fas fa-shopping-cart text-primary"></i>
                        </a>

                    </div>

                </div>

            </nav>
        </div>
    </div>
</div>
<!-- Navbar End -->