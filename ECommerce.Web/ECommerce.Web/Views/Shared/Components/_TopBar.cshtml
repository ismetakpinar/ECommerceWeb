@inject ECommerce.Web.Infrastructure.Authentication.ITokenService TokenService

<div class="container-fluid">
    <div class="row bg-secondary py-1 px-xl-5">

        <div class="col-lg-6 d-none d-lg-block">
            <div class="d-inline-flex align-items-center h-100">

                <a class="text-body mr-3" href="/#categories">Kategoriler</a>
                <a class="text-body mr-3" asp-controller="Product" asp-action="Index">Ürünler</a>
                @if (!string.IsNullOrWhiteSpace(TokenService.GetAccessToken()))
                {
                    <a class="text-body mr-3" asp-controller="Order" asp-action="Index">Siparişlerim</a>
                }

            </div>
        </div>

        <div class="col-lg-6 text-center text-lg-right">

            <div class="d-inline-flex align-items-center">

                <div class="btn-group">
                    <button type="button"
                            class="btn btn-sm btn-light dropdown-toggle"
                            data-toggle="dropdown">
                        Hesabım
                    </button>

                    <div class="dropdown-menu dropdown-menu-right">
                        @if (string.IsNullOrWhiteSpace(TokenService.GetAccessToken()))
                        {
                            <a class="dropdown-item" asp-controller="Account" asp-action="Login">Giriş Yap</a>
                            <a class="dropdown-item" asp-controller="Account" asp-action="Register">Kayıt Ol</a>
                        }
                        else
                        {
                            <a class="dropdown-item" asp-controller="Order" asp-action="Index">Siparişlerim</a>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item">Çıkış Yap</button>
                            </form>
                        }
                        <a class="dropdown-item" asp-controller="Cart" asp-action="Index">Sepetim</a>
                    </div>
                </div>

            </div>

            <div class="d-inline-flex align-items-center d-block d-lg-none">

                <a asp-controller="Cart" asp-action="Index" class="btn px-0 ml-2">
                      <i class="fas fa-shopping-cart text-dark" aria-label="Sepetim"></i>
                </a>

            </div>

        </div>

    </div>
</div>