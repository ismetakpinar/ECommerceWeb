@inject ECommerce.Web.Infrastructure.Authentication.ITokenService TokenService

<footer class="container-fluid bg-dark text-secondary mt-5 pt-5">
    <div class="row px-xl-5 pt-3">
        <div class="col-lg-4 col-md-6 mb-4">
            <h5 class="text-light text-uppercase mb-3">ECommerce</h5>
            <p class="mb-0">Ürünleri inceleyin, sepetinizi yönetin ve siparişlerinizi hesabınızdan takip edin.</p>
        </div>

        <div class="col-lg-4 col-md-6 mb-4">
            <h5 class="text-light text-uppercase mb-3">Mağaza</h5>
            <div class="d-flex flex-column">
                <a class="text-secondary mb-2" asp-controller="Product" asp-action="Index">Tüm Ürünler</a>
                <a class="text-secondary mb-2" asp-controller="Home" asp-action="Index" asp-fragment="categories">Kategoriler</a>
                <a class="text-secondary" asp-controller="Cart" asp-action="Index">Sepetim</a>
            </div>
        </div>

        <div class="col-lg-4 col-md-6 mb-4">
            <h5 class="text-light text-uppercase mb-3">Hesabım</h5>
            <div class="d-flex flex-column">
                @if (string.IsNullOrWhiteSpace(TokenService.GetAccessToken()))
                {
                    <a class="text-secondary mb-2" asp-controller="Account" asp-action="Login">Giriş Yap</a>
                    <a class="text-secondary" asp-controller="Account" asp-action="Register">Kayıt Ol</a>
                }
                else
                {
                    <a class="text-secondary mb-2" asp-controller="Order" asp-action="Index">Siparişlerim</a>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-link text-secondary p-0">Çıkış Yap</button>
                    </form>
                }
            </div>
        </div>
    </div>

    <div class="row border-top mx-xl-5 py-3" style="border-color: rgba(256, 256, 256, .1) !important;">
        <div class="col-12 text-center text-secondary">
            &copy; @DateTime.UtcNow.Year <a class="text-primary" asp-controller="Home" asp-action="Index">ECommerce</a>
        </div>
    </div>
</footer>