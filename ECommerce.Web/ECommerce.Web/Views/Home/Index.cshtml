@model ECommerce.Web.ViewModels.Home.HomeViewModel

@{
    ViewData["Title"] = "Ana Sayfa";
}

@await Html.PartialAsync("Components/_Carousel")

@await Html.PartialAsync("Components/_Featured")

@await Html.PartialAsync(
    "Components/_Categories",
