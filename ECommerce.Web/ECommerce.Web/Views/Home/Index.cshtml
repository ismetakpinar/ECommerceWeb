@await Html.PartialAsync(
    "Components/_FeaturedProducts",
    Model.FeaturedProducts)

@await Html.PartialAsync("Components/_Offer")

@await Html.PartialAsync(
    "Components/_RecentProducts",
    Model.RecentProducts)

@await Html.PartialAsync("Components/_Vendor")