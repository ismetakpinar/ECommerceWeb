@using ECommerce.Web.Helpers
@model IReadOnlyCollection<ECommerce.Web.ViewModels.Category.CategoryListViewModel>

@{
    var slides = Model
        .Where(category => CategoryImageHelper.GetCarouselImagePath(category.Name) is not null)
        .Take(3)
        .ToList();
}

@if (slides.Count > 0)
{
    <div class="container-fluid mb-3">
        <div class="row px-xl-5">
            <div class="col-lg-12">
                <div id="header-carousel" class="carousel slide carousel-fade mb-30 mb-lg-0" data-ride="carousel">
                    <ol class="carousel-indicators">
                        @for (var index = 0; index < slides.Count; index++)
                        {
                            <li data-target="#header-carousel" data-slide-to="@index" class="@(index == 0 ? "active" : "")">
                            </li>
                        }
                    </ol>

                    <div class="carousel-inner">
                        @for (var index = 0; index < slides.Count; index++)
                        {
                            var category = slides[index];
                            var imagePath = CategoryImageHelper.GetCarouselImagePath(category.Name)!;

                            <div class="carousel-item position-relative @(index == 0 ? "active" : "")" style="height: 430px;">
                                <img class="position-absolute w-100 h-100" src="@Url.Content(imagePath)" alt="@category.Name"
                                     style="object-fit: cover;" fetchpriority="@(index == 0 ? "high" : "auto")">
                                <div class="carousel-caption d-flex flex-column align-items-center justify-content-center">
                                    <div class="p-3" style="max-width: 700px;">
                                        <h1 class="display-4 text-white mb-3">@category.Name</h1>
                                        <p class="mx-md-5 px-5">Bu kategorideki ürünleri keşfedin.</p>
                                        <a class="btn btn-outline-light py-2 px-4 mt-3" asp-controller="Product"
                                           asp-action="Index" asp-route-categoryId="@category.CategoryId">Ürünleri Gör</a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <a class="carousel-control-prev" href="#header-carousel" role="button" data-slide="prev"
                       aria-label="Önceki kategori">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    </a>
                    <a class="carousel-control-next" href="#header-carousel" role="button" data-slide="next"
                       aria-label="Sonraki kategori">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    </a>
                </div>
            </div>
        </div>
    </div>
}