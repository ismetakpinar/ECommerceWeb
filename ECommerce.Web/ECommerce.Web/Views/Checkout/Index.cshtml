@model ECommerce.Web.ViewModels.Checkout.CheckoutViewModel

@{
    ViewData["Title"] = "Siparişi Tamamla";
}

<div class="container-fluid py-5">

    <div class="container">

        <div class="mb-4">

            <h2 class="font-weight-bold">

                Siparişi Tamamla

            </h2>

            <p class="text-muted">

                Teslimat adresinizi seçerek siparişinizi tamamlayabilirsiniz.

            </p>

        </div>

        <form asp-action="Index"
              method="post">

            @Html.AntiForgeryToken()

            <div class="row">

                <!-- SOL TARAF -->

                <div class="col-lg-8">

                    <!-- TESLİMAT ADRESİ -->

                    <div class="card shadow-sm mb-4">

                        <div class="card-header bg-dark text-white">

                            <i class="fa fa-map-marker-alt mr-2"></i>

                            Teslimat Adresi

                        </div>

                        <div class="card-body">

                            @if (Model.Addresses.Any())
                            {
                                foreach (var address in Model.Addresses)
                                {
                                    <div class="border rounded p-3 mb-3">

                                        <div class="custom-control custom-radio">

                                            <input class="custom-control-input"
                                                   type="radio"
                                                   asp-for="AddressId"
                                                   id="address_@address.AddressId"
                                                   value="@address.AddressId" />

                                            <label class="custom-control-label w-100"
                                                   for="address_@address.AddressId">

                                                <strong>

                                                    @address.Title

                                                </strong>

                                                <br />

                                                <span class="text-muted">

                                                    @address.City /
                                                    @address.District

                                                </span>

                                                <br />

                                                @address.FullAddress

                                            </label>

                                        </div>

                                    </div>
                                }
                            }
                            else
                            {
                                <div class="alert alert-warning mb-0">

                                    Henüz kayıtlı adresiniz bulunmuyor.

                                </div>
                            }

                            <span asp-validation-for="AddressId"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                    <!-- SİPARİŞ NOTU -->

                    <div class="card shadow-sm">

                        <div class="card-header bg-dark text-white">

                            <i class="fa fa-edit mr-2"></i>

                            Sipariş Notu

                        </div>

                        <div class="card-body">

                            <textarea asp-for="Note"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Kuryeye iletmek istediğiniz notu yazabilirsiniz...">
                            </textarea>

                        </div>

                    </div>

                </div>

                <!-- SAĞ TARAF -->

                <div class="col-lg-4">

                    <div class="card shadow sticky-top"
                         style="top:20px;">

                        <div class="card-header bg-dark text-white">

                            <i class="fa fa-shopping-cart mr-2"></i>

                            Sipariş Özeti

                        </div>

                        <div class="card-body">

                            @foreach (var item in Model.Cart.Items)
                            {
                                <div class="d-flex justify-content-between mb-3">
                                    <div>
                                        <strong>@item.ProductName</strong><br />
                                        <small class="text-muted">
                                            @item.Quantity x @item.UnitPrice.ToString("N2") ₺
                                        </small>
                                    </div>
                                    <strong>@item.TotalAmount.ToString("N2") ₺</strong>
                                </div>
                            }

                            <div class="d-flex justify-content-between">
                                <span>Ara Toplam</span>
                                <strong>@Model.Cart.SubTotal.ToString("N2") ₺</strong>
                            </div>

                            <div class="d-flex justify-content-between mt-2">
                                <span>Kargo</span>
                                <strong class="text-success">
                                    @(Model.Cart.Shipping == 0 ? "Ücretsiz" : Model.Cart.Shipping.ToString("N2") + " ₺")
                                </strong>
                            </div>

                            <hr />

                            <div class="d-flex justify-content-between mb-3">
                                <strong>Genel Toplam</strong>
                                <strong class="text-warning">@Model.Cart.Total.ToString("N2") ₺</strong>
                            </div>

                            <div class="alert alert-light border">
                                <small class="text-muted">
                                    Siparişinizi onayladığınızda stok kontrolü yeniden yapılacaktır.
                                </small>
                            </div>

                            <button type="submit"
                                    class="btn btn-warning btn-lg btn-block font-weight-bold">

                                <i class="fa fa-check mr-2"></i>

                                Siparişi Onayla

                            </button>

                            <a asp-controller="Cart"
                               asp-action="Index"
                               class="btn btn-outline-secondary btn-block mt-3">

                                <i class="fa fa-arrow-left mr-2"></i>

                                Sepete Dön

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </form>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}